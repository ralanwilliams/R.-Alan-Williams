<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Integration tests against real PostgreSQL. Uses CV_TEST_POSTGRES (an admin connection
    string to a disposable server) if set, otherwise starts postgres:17 with Testcontainers.
    With neither available the tests are skipped, unless CV_TEST_REQUIRE_DATABASE=1 (CI).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cv.Data\Cv.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
