<Project>
  <!-- Test projects: everything from the repository-wide props, plus the settings below. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!--
      xUnit1051 asks every async call to take TestContext.Current.CancellationToken. These
      tests are short and bounded; passing a token to every call adds noise, not safety.
    -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
</Project>
