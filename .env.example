# Copy to .env (git-ignored) and fill in real values. Never commit .env.
# Load into the current PowerShell session with:  . ./scripts/Import-DotEnv.ps1

# Supabase Postgres via the Session pooler, in Npgsql key/value format (not a postgresql:// URI).
# The schema owner. Used by dotnet-ef and src/Cv.Migrator. See docs/cv-database.md §3.
CV_DB_CONNECTION=Host=aws-0-<region>.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.<project-ref>;Password=<db-password>;SSL Mode=Require

# The editor's least-privilege login (cv_api, a member of cv_app). Required by src/Cv.Editor.
# Create the role first: docs/cv-database.md §6. See docs/cv-editor.md §2.
CV_API_CONNECTION=Host=aws-0-<region>.pooler.supabase.com;Port=5432;Database=postgres;Username=cv_api.<project-ref>;Password=<cv-api-password>;SSL Mode=Require

# Optional. Which cv.users row is the author; only needed if there is more than one.
# CV_EDITOR_USER_EMAIL=you@example.com

# Optional. A CV outline to open while no version has been saved yet (docs/cv-editor.md, "Seeding").
# Relative to the repository root. Keep it in seed/, which is git-ignored.
# CV_SEED_FILE=seed/cv.json

# Optional. Chrome, Edge or Chromium for PDF output, if not found in the usual places.
# CV_CHROMIUM_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Cloudflare account that hosts the Pages project "ralanwilliams". Wrangler reads this.
CLOUDFLARE_ACCOUNT_ID=<cloudflare-account-id>
